# Copier ce fichier en .env (dev) et NE JAMAIS commiter le résultat — .env
# est déjà ignoré par git (voir .gitignore).

# Clé secrète Django — obligatoire, aucune valeur par défaut dans le code.
# Générer une valeur unique par environnement (jamais réutiliser celle du
# dev en prod) : python -c "from django.core.management.utils import
# get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True en dev local uniquement. DOIT être False (ou absent) en production.
DEBUG=

# --- Base de données --------------------------------------------------
# Option A (recommandée en prod, ex. Heroku) : une seule URL complète,
# format postgres://utilisateur:motdepasse@hote:port/nom_base. Si définie,
# elle prime sur les 5 variables DB_* ci-dessous (voir config/settings.py).
DATABASE_URL=

# Option B (dev local) : variables séparées, utilisées seulement si
# DATABASE_URL est vide.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Réseau / CORS -------------------------------------------------------
# Domaine(s) additionnel(s) à autoriser dans ALLOWED_HOSTS en prod (ex. le
# domaine Heroku du backend lui-même), séparés par des virgules si plusieurs.
ALLOWED_HOSTS_SUPPLEMENTAIRES=

# URL publique du frontend déployé (Vercel), autorisée en CORS. Sans slash
# final. Ex. https://fahimtana.vercel.app
FRONTEND_URL=

# --- Génération IA (programme.ia) ----------------------------------------
IA_FOURNISSEUR=
ANTHROPIC_API_KEY=
IA_MODELE=
IA_TIMEOUT_SECONDES=
IA_MAX_TOKENS_REPONSE=
IA_NOTION_MODELE_ID=

# --- Lecture/analyse des exercices deposes par les eleves ----------------
# DESACTIVE PAR DEFAUT (chaque analyse = un appel Anthropic facture, avec
# images/PDF). Meme avec IA_LECTURE_ACTIVE=True, rien ne part hors DEBUG=True
# tant que IA_LECTURE_DEV_SEULEMENT reste True (valeur par defaut).
IA_LECTURE_ACTIVE=
IA_LECTURE_DEV_SEULEMENT=
# Vide = reutilise IA_MODELE (doit accepter images et PDF).
IA_LECTURE_MODELE=
IA_LECTURE_MAX_TOKENS=
IA_LECTURE_TIMEOUT_SECONDES=
IA_LECTURE_CACHE_SECONDES=

# --- Cloudinary (photo de profil élève, comptes.User.photo) --------------
# Les 3 variables doivent être renseignées ENSEMBLE pour que le stockage
# Cloudinary s'active (voir CLOUDINARY_CONFIGURE, config/settings.py) — si
# l'une des trois manque, le champ photo retombe silencieusement sur le
# stockage local (dev), aucun upload Cloudinary n'est tenté.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paiement NITA (comptes/nita.py, comptes/nita_views.py) --------------
# Les 4 variables sont NÉCESSAIRES pour un vrai appel NITA (aucun défaut
# secret dans le code — voir NitaError). Exemple de NITA_BASE_URL :
# https://payment.nitapiservices.com
NITA_BASE_URL=
NITA_API_KEY=
NITA_USERNAME=
NITA_PASSWORD=
# Délai (secondes) avant d'abandonner un appel NITA. Optionnel (défaut 20).
NITA_TIMEOUT_SECONDES=
# Mettre à 1 UNIQUEMENT en dev local pour tester tout le circuit NITA sans
# appeler la vraie API (voir comptes/nita.py, NitaMockConfirmerView) —
# JAMAIS en production. Laisser vide (= False) partout ailleurs.
NITA_MOCK=

# --- SMS LAM / LAMPUSH (comptes/sms.py) -----------------------------------
# LAM_SMS_URL a un défaut sensé (https://lamsms.lafricamobile.com/api),
# les 3 autres sont OBLIGATOIRES pour un envoi réel. LAM_DEFAULT_SENDER :
# max 11 caractères, ne doit pas commencer par un chiffre (contrainte LAM).
LAM_SMS_URL=
LAM_ACCOUNTID=
LAM_PASSWORD=
LAM_DEFAULT_SENDER=
# Mettre à 1 UNIQUEMENT en dev local pour tester l'envoi de SMS sans
# consommer de crédits réels (les SMS sont juste loggés) — JAMAIS en
# production. Laisser vide (= False) partout ailleurs.
SMS_MOCK=

# Correction complete des exercices de maths (etape 6) : DESACTIVEE par defaut.
# Chaque correction = 1 appel Anthropic + quelques requetes Wolfram Alpha.
# IA_CORRECTION_ACTIVE=False
# IA_CORRECTION_DEV_SEULEMENT=True
# IA_CORRECTION_MODELE=
# WOLFRAM_APP_ID=

# Professeur particulier IA (etape 7) : DESACTIVE par defaut.
# Un appel Anthropic pour le plan de la seance, puis un appel court seulement
# quand l'eleve se trompe ou demande une explication. Seances en cache (temporaires).
# IA_PROF_ACTIVE=False
# IA_PROF_DEV_SEULEMENT=True
# IA_PROF_MODELE=
# IA_PROF_SEANCE_SECONDES=7200
# IA_PROF_MAX_APPELS_IA=40
# IA_PROF_MAX_ECHANGES=80
# IA_PROF_MAX_SEANCES_PAR_HEURE=6
